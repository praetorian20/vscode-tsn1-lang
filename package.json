{
    "name": "tsn1-lang",
    "displayName": "vscode-tsn1-lang",
    "description": "TSN.1 grammar",
    "publisher": "praetorian20",
    "repository": "https://github.com/praetorian20/vscode-tsn1-lang",
    "license": "CC0-1.0",
    "version": "0.0.1",
    "engines": {
        "node": ">=10",
        "vscode": "^1.136.0"
    },
    "categories": [
        "Programming Languages"
    ],
    "activationEvents": [
        "onLanguage:tsn",
        "workspaceContains:**/*.tsn"
    ],
    "main": "./out/src/extension.js",
    "contributes": {
        "languages": [
            {
                "id": "tsn",
                "aliases": [
                    "TSN1",
                    "tsn"
                ],
                "extensions": [
                    ".tsn"
                ],
                "configuration": "./language-configuration.json"
            }
        ],
        "grammars": [
            {
                "language": "tsn",
                "scopeName": "source.tsn",
                "path": "./syntaxes/tsn.tmLanguage.json"
            }
        ]
    },
    "scripts": {
        "vscode:prepublish": "npm run compile",
        "compile": "npm run gen && tsc -p ./",
        "clean": "rimraf out src/parser.ts *.vsix",
        "gen": "tspeg src/grammar.peg src/parser.ts",
        "package": "vsce package",
        "watch": "tsc -w -p ./"
    },
    "devDependencies": {
        "@types/vscode": "^1.136.0",
        "cheerio": "1.0.0-rc.12",
        "rimraf": "3.0.2",
        "tspeg": "3.1.0",
        "typescript": "^4.9.5",
        "vsce": "^1.103.1"
    }
}
